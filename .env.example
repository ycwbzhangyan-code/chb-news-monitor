# ===========================================
# 创兴银行新闻监测系统 - 环境变量配置模板
# ===========================================
# 复制本文件为 .env 并填入实际值
# GitHub Secrets 中也需配置相同的变量

# ---------- 邮件推送（SMTP）----------
# 推荐使用 Gmail App Password 或企业邮箱 SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_ADDR=chb-monitor@chonghing.uk

# 收件人（多个用逗号分隔）
TO_ADDRS=comms-team1@chonghing.com,comms-team2@chonghing.com

# 密送（可选，多个用逗号分隔）
BCC_ADDRS=head@chonghing.com

# ---------- Vercel 部署 ----------
# 在 Vercel 项目设置中创建 Deploy Hook 后填入
VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/xxxxxxxx

# ---------- 可选：邮件通知开关 ----------
# 设为 false 时即使有新闻也不发邮件（用于调试）
ENABLE_EMAIL_PUSH=true
